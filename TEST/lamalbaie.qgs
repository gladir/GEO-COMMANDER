<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte de la ville de La Malbaie (Québec) avec ses rues" version="3.34.0-Pascal">
  <title>Carte de la ville de La Malbaie (Québec) avec ses rues</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="CONTOURS___VILLE_1" name="Contours : Ville" source="./lamalbaie_ville.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
