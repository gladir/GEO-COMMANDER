    <layer-tree-layer id="PARCS_ET_ESPACES_VERTS_10" name="Parcs et espaces verts" source="./lamalbaie_parcs.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PLANS_D_EAU_11" name="Plans d eau" source="./lamalbaie_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-7814628</xmin><ymin>6044859</ymin><xmax>-7803496</xmax><ymax>6052790</ymax></extent>
