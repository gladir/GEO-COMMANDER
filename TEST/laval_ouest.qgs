    <layer-tree-layer id="PLANS_D_EAU_10" name="Plans d eau" source="./laval_ouest_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-8226844</xmin><ymin>5705388</ymin><xmax>-8219052</xmax><ymax>5711031</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
