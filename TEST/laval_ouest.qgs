<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte de Laval-Ouest (Laval, Québec) avec ses rues" version="3.34.0-Pascal">
  <title>Carte de Laval-Ouest (Laval, Québec) avec ses rues</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="LIMITE_DU_QUARTIER_1" name="Limite du quartier" source="./laval_ouest_quartier.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
