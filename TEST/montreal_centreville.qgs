<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte du centre-ville de Montréal (Québec) avec ses rues" version="3.34.0-Pascal">
  <title>Carte du centre-ville de Montréal (Québec) avec ses rues</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="RUES_PRINCIPALES_1" name="Rues principales" source="./montreal_centreville_major.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUES_SECONDAIRES_2" name="Rues secondaires" source="./montreal_centreville_sec.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUES_LOCALES_3" name="Rues locales" source="./montreal_centreville_loc.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUELLES_ET_VOIES_DE_SERVICE_4" name="Ruelles et voies de service" source="./montreal_centreville_svc.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="SENTIERS_ET_PISTES_CYCLABLES_5" name="Sentiers et pistes cyclables" source="./montreal_centreville_path.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="VOIES_FERREES_6" name="Voies ferrees" source="./montreal_centreville_rail.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="COURS_D_EAU_7" name="Cours d eau" source="./montreal_centreville_cours_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PARCS_ET_ESPACES_VERTS_8" name="Parcs et espaces verts" source="./montreal_centreville_parcs.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PLANS_D_EAU_9" name="Plans d eau" source="./montreal_centreville_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-8193337</xmin><ymin>5698399</ymin><xmax>-8186658</xmax><ymax>5703402</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Line">
      <id>RUES_PRINCIPALES_1</id>
