<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte de la Gaspésie (et Îles-de-la-Madeleine)" version="3.34.0-Pascal">
  <title>Carte de la Gaspésie (et Îles-de-la-Madeleine)</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="MUNICIPALITES_DE_LA_REGION_GASPESIE-ILES-DE-LA-MADELEINE_1" name="Municipalites de la region Gaspesie-Iles-de-la-Madeleine" source="./gaspesie_ville.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="MUNICIPALITES_VOISINES_2" name="Municipalites voisines" source="./gaspesie_voisines.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-7678056</xmin><ymin>5909880</ymin><xmax>-6661004</xmax><ymax>6388638</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Polygon">
      <id>MUNICIPALITES_DE_LA_REGION_GASPESIE-ILES-DE-LA-MADELEINE_1</id>
      <datasource>./gaspesie_ville.geojson</datasource>
      <layername>Municipalites de la region Gaspesie-Iles-de-la-Madeleine</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="14" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>MUNICIPALITES_VOISINES_2</id>
      <datasource>./gaspesie_voisines.geojson</datasource>
      <layername>Municipalites voisines</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="10" type="QString"/></Option></customproperties>
    </maplayer>
  </projectlayers>
</qgis>
