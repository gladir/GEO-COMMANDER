    <layer-tree-layer id="PARCS_ET_ESPACES_VERTS_9" name="Parcs et espaces verts" source="./saintadele_parcs.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PLANS_D_EAU_10" name="Plans d eau" source="./saintadele_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-8257680</xmin><ymin>5768339</ymin><xmax>-8246548</xmax><ymax>5776344</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
