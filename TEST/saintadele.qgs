    <layer-tree-layer id="RUES_PRINCIPALES_3" name="Rues principales" source="./saintadele_major.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUES_SECONDAIRES_4" name="Rues secondaires" source="./saintadele_sec.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUES_LOCALES_5" name="Rues locales" source="./saintadele_loc.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUELLES_ET_VOIES_DE_SERVICE_6" name="Ruelles et voies de service" source="./saintadele_svc.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="SENTIERS_ET_PISTES_CYCLABLES_7" name="Sentiers et pistes cyclables" source="./saintadele_path.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
