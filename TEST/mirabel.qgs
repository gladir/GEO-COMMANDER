    <layer-tree-layer id="PARCS_ET_ESPACES_VERTS_10" name="Parcs et espaces verts" source="./mirabel_parcs.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PLANS_D_EAU_11" name="Plans d eau" source="./mirabel_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-8253227</xmin><ymin>5719662</ymin><xmax>-8239869</xmax><ymax>5729216</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
