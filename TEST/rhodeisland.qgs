<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte de l'État de Rhode Island" version="3.34.0-Pascal">
  <title>Carte de l'État de Rhode Island</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="VILLES_1" name="Villes" source="./rhodeisland_villes.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="COMTES_2" name="Comtes" source="./rhodeisland_regions.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="VOISINS_3" name="Voisins" source="./rhodeisland_voisins.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-8000532</xmin><ymin>5056693</ymin><xmax>-7927061</xmax><ymax>5166973</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Point">
      <id>VILLES_1</id>
      <datasource>./rhodeisland_villes.geojson</datasource>
      <layername>Villes</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="12" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>COMTES_2</id>
      <datasource>./rhodeisland_regions.geojson</datasource>
      <layername>Comtes</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="10" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>VOISINS_3</id>
      <datasource>./rhodeisland_voisins.geojson</datasource>
      <layername>Voisins</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="7" type="QString"/></Option></customproperties>
    </maplayer>
  </projectlayers>
</qgis>
