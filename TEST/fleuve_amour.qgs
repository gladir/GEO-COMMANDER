<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte du fleuve Amour" version="3.34.0-Pascal">
  <title>Carte du fleuve Amour</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="VILLES_1" name="Villes" source="./fleuve_amour_villes.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="FLEUVE_AMOUR_2" name="Fleuve amour" source="./fleuve_amour_fleuve.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="AFFLUENTS_ET_AUTRES_COURS_D_EAU_3" name="Affluents et autres cours d'eau" source="./fleuve_amour_affluents.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="LACS_4" name="Lacs" source="./fleuve_amour_lacs.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="REGIONS_DE_LA_RUSSIE_5" name="Regions de la Russie" source="./russie_regions.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PROVINCES_DE_LA_CHINE_6" name="Provinces de la Chine" source="./chine_regions.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PAYS_7" name="Pays" source="./monde_pays.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>12022505</xmin><ymin>4865942</ymin><xmax>15807368</xmax><ymax>7760119</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Point">
      <id>VILLES_1</id>
      <datasource>./fleuve_amour_villes.geojson</datasource>
      <layername>Villes</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="12" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Line">
      <id>FLEUVE_AMOUR_2</id>
      <datasource>./fleuve_amour_fleuve.geojson</datasource>
      <layername>Fleuve amour</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="12" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Line">
      <id>AFFLUENTS_ET_AUTRES_COURS_D_EAU_3</id>
      <datasource>./fleuve_amour_affluents.geojson</datasource>
      <layername>Affluents et autres cours d'eau</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="9" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>LACS_4</id>
      <datasource>./fleuve_amour_lacs.geojson</datasource>
      <layername>Lacs</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
