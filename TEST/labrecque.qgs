<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte de Labrecque (Québec) avec ses rues" version="3.34.0-Pascal">
  <title>Carte de Labrecque (Québec) avec ses rues</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="CONTOURS___VILLE_1" name="Contours : Ville" source="./labrecque_ville.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="CONTOURS___MUNICIPALITES_VOISINES_2" name="Contours : Municipalites voisines" source="./labrecque_voisines.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUES_SECONDAIRES_3" name="Rues secondaires" source="./labrecque_sec.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUES_LOCALES_4" name="Rues locales" source="./labrecque_loc.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUELLES_ET_VOIES_DE_SERVICE_5" name="Ruelles et voies de service" source="./labrecque_svc.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="SENTIERS_ET_PISTES_CYCLABLES_6" name="Sentiers et pistes cyclables" source="./labrecque_path.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="COURS_D_EAU_7" name="Cours d eau" source="./labrecque_cours_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PARCS_ET_ESPACES_VERTS_8" name="Parcs et espaces verts" source="./labrecque_parcs.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PLANS_D_EAU_9" name="Plans d eau" source="./labrecque_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-7966023</xmin><ymin>6215091</ymin><xmax>-7954891</xmax><ymax>6223014</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Line">
      <id>CONTOURS___VILLE_1</id>
      <datasource>./labrecque_ville.geojson</datasource>
      <layername>Contours : Ville</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
