<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Le métro de Montréal (STM)" version="3.34.0-Pascal">
  <title>Le métro de Montréal (STM)</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="STATIONS_1" name="Stations" source="./metro_montreal_stations.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="LIGNE_1_VERTE_2" name="Ligne 1 verte" source="./metro_montreal_verte.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="LIGNE_2_ORANGE_3" name="Ligne 2 orange" source="./metro_montreal_orange.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="LIGNE_4_JAUNE_4" name="Ligne 4 jaune" source="./metro_montreal_jaune.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="LIGNE_5_BLEUE_5" name="Ligne 5 bleue" source="./metro_montreal_bleue.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="LIGNE_5_BLEUE__PROLONGEMENT_EN_CONSTRUCTION__6" name="Ligne 5 bleue (prolongement en construction)" source="./metro_montreal_bleueext.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PLANS_D_EAU_7" name="Plans d eau" source="./metro_montreal_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-8213152</xmin><ymin>5695819</ymin><xmax>-8178643</xmax><ymax>5719662</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Point">
      <id>STATIONS_1</id>
      <datasource>./metro_montreal_stations.geojson</datasource>
      <layername>Stations</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
