<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte du fleuve Saint-Laurent" version="3.34.0-Pascal">
  <title>Carte du fleuve Saint-Laurent</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="VILLES_1" name="Villes" source="./fleuve_saintlaurent_villes.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
