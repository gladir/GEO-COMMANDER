    <layer-tree-layer id="LACS_4" name="Lacs" source="./fleuve_saintlaurent_lacs.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PROVINCES_CANADIENNES_5" name="Provinces canadiennes" source="./canada_provinces.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="ETATS_AMERICAINS_6" name="Etats americains" source="./etatsunis_regions.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-8961219</xmin><ymin>5221087</ymin><xmax>-6345211</xmax><ymax>6710219</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Point">
