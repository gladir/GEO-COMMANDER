  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-75524</xmin><ymin>6657767</ymin><xmax>55967</xmax><ymax>6759167</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
