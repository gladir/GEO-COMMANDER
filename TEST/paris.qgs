    <extent><xmin>254365</xmin><ymin>6245558</ymin><xmax>267723</xmax><ymax>6255032</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
