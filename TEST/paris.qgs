    <layer-tree-layer id="RUES_LOCALES__1_2__6" name="Rues locales (1/2)" source="./paris_loc1.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUES_LOCALES__2_2__7" name="Rues locales (2/2)" source="./paris_loc2.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
