    <layer-tree-layer id="COURS_D_EAU_11" name="Cours d eau" source="./paris_cours_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PARCS_ET_ESPACES_VERTS_12" name="Parcs et espaces verts" source="./paris_parcs.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PLANS_D_EAU_13" name="Plans d eau" source="./paris_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
