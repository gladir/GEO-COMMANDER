<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte de l'État du Delaware" version="3.34.0-Pascal">
  <title>Carte de l'État du Delaware</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="VILLES_1" name="Villes" source="./delaware_villes.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="COMTES_2" name="Comtes" source="./delaware_regions.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="VOISINS_3" name="Voisins" source="./delaware_voisins.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-8439131</xmin><ymin>4636088</ymin><xmax>-8350075</xmax><ymax>4851421</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Point">
      <id>VILLES_1</id>
      <datasource>./delaware_villes.geojson</datasource>
      <layername>Villes</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="12" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>COMTES_2</id>
      <datasource>./delaware_regions.geojson</datasource>
      <layername>Comtes</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="10" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>VOISINS_3</id>
      <datasource>./delaware_voisins.geojson</datasource>
      <layername>Voisins</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="7" type="QString"/></Option></customproperties>
    </maplayer>
  </projectlayers>
</qgis>
