<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte des îles Caïmans" version="3.34.0-Pascal">
  <title>Carte des îles Caïmans</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="VILLES_1" name="Villes" source="./caimans_villes.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PAYS_2" name="Pays" source="./caimans_regions.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PAYS_VOISINS_3" name="Pays voisins" source="./caimans_voisins.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-9074765</xmin><ymin>2183448</ymin><xmax>-8865707</xmax><ymax>2248762</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Point">
      <id>VILLES_1</id>
      <datasource>./caimans_villes.geojson</datasource>
      <layername>Villes</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="12" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>PAYS_2</id>
      <datasource>./caimans_regions.geojson</datasource>
      <layername>Pays</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="10" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>PAYS_VOISINS_3</id>
      <datasource>./caimans_voisins.geojson</datasource>
      <layername>Pays voisins</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="7" type="QString"/></Option></customproperties>
    </maplayer>
  </projectlayers>
</qgis>
