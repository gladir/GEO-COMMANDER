<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte des Tonga" version="3.34.0-Pascal">
  <title>Carte des Tonga</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="VILLES_1" name="Villes" source="./tonga_villes.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="REGIONS_2" name="Regions" source="./tonga_regions.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PAYS_VOISINS_3" name="Pays voisins" source="./tonga_voisins.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-19530893</xmin><ymin>-2466441</ymin><xmax>-19351224</xmax><ymax>-2083483</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Point">
      <id>VILLES_1</id>
      <datasource>./tonga_villes.geojson</datasource>
      <layername>Villes</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="12" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>REGIONS_2</id>
      <datasource>./tonga_regions.geojson</datasource>
      <layername>Regions</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="10" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>PAYS_VOISINS_3</id>
      <datasource>./tonga_voisins.geojson</datasource>
      <layername>Pays voisins</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="7" type="QString"/></Option></customproperties>
    </maplayer>
  </projectlayers>
</qgis>
