    <layer-tree-layer id="PLANS_D_EAU_11" name="Plans d eau" source="./saintedorothee_eau.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
