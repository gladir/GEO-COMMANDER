<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte du quartier Sainte-Dorothée (Laval, Québec) avec ses rues" version="3.34.0-Pascal">
  <title>Carte du quartier Sainte-Dorothée (Laval, Québec) avec ses rues</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="LIMITE_DU_QUARTIER_1" name="Limite du quartier" source="./saintedorothee_quartier.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
