    <layer-tree-layer id="RUES_LOCALES_5" name="Rues locales" source="./saintedorothee_loc.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="RUELLES_ET_VOIES_DE_SERVICE_6" name="Ruelles et voies de service" source="./saintedorothee_svc.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
