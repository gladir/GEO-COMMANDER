<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte de la ville de Tokyo (Japon)" version="3.34.0-Pascal">
  <title>Carte de la ville de Tokyo (Japon)</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="ARRONDISSEMENTS_SPECIAUX_1" name="Arrondissements speciaux" source="./tokyo_ville.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="MUNICIPALITES_VOISINES_2" name="Municipalites voisines" source="./tokyo_voisines.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>15528133</xmin><ymin>4226790</ymin><xmax>15583607</xmax><ymax>4283681</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Polygon">
      <id>ARRONDISSEMENTS_SPECIAUX_1</id>
      <datasource>./tokyo_ville.geojson</datasource>
      <layername>Arrondissements speciaux</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="14" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>MUNICIPALITES_VOISINES_2</id>
      <datasource>./tokyo_voisines.geojson</datasource>
      <layername>Municipalites voisines</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="10" type="QString"/></Option></customproperties>
    </maplayer>
  </projectlayers>
</qgis>
