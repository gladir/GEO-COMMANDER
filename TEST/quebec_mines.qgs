<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="Carte des principales mines du Québec (sélection)" version="3.34.0-Pascal">
  <title>Carte des principales mines du Québec (sélection)</title>
  <projectCrs>
    <spatialrefsys><authid>EPSG:3857</authid></spatialrefsys>
  </projectCrs>
  <layer-tree-group>
    <layer-tree-layer id="MINES__SELECTION__POSITIONS_APPROXIMATIVES__1" name="Mines (selection, positions approximatives)" source="./quebec_mines.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="REGIONS_ADMINISTRATIVES_2" name="Regions administratives" source="./quebec_regions.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
    <layer-tree-layer id="PROVINCES_ET_ETATS_VOISINS_3" name="Provinces et Etats voisins" source="./quebec_voisins.geojson" providerKey="ogr" checked="Qt::Checked" expanded="1"/>
  </layer-tree-group>
  <mapcanvas name="theMapCanvas">
    <units>0</units>
    <extent><xmin>-8905559</xmin><ymin>5605792</ymin><xmax>-6345211</xmax><ymax>9002835</ymax></extent>
    <destinationsrs><spatialrefsys><authid>EPSG:3857</authid></spatialrefsys></destinationsrs>
  </mapcanvas>
  <projectlayers>
    <maplayer type="vector" geometry="Point">
      <id>MINES__SELECTION__POSITIONS_APPROXIMATIVES__1</id>
      <datasource>./quebec_mines.geojson</datasource>
      <layername>Mines (selection, positions approximatives)</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="14" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>REGIONS_ADMINISTRATIVES_2</id>
      <datasource>./quebec_regions.geojson</datasource>
      <layername>Regions administratives</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="10" type="QString"/></Option></customproperties>
    </maplayer>
    <maplayer type="vector" geometry="Polygon">
      <id>PROVINCES_ET_ETATS_VOISINS_3</id>
      <datasource>./quebec_voisins.geojson</datasource>
      <layername>Provinces et Etats voisins</layername>
      <srs><spatialrefsys><authid>EPSG:4326</authid></spatialrefsys></srs>
      <provider encoding="UTF-8">ogr</provider>
      <customproperties><Option type="Map"><Option name="pascal_color" value="7" type="QString"/></Option></customproperties>
    </maplayer>
  </projectlayers>
</qgis>
